# =====================================================
# GUIDIFY Environment Variables — EXAMPLE FILE
# =====================================================
# NEVER commit real credentials. Copy this file to .env and fill in your values.
# .env files are gitignored and should NEVER be committed to version control.

# ── Frontend (.env in guidify-frontend/) ──
VITE_API_URL=https://your-backend-url.onrender.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Backend (.env in guidify-backend/) ──
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
ENABLE_SENTRY=false
SENTRY_DSN=
